@echo off
chcp 65001 > nul
echo ===================================================
echo   ระบบลงคะแนนการแข่งขันวงดนตรี (กรรมการ 5 ท่าน)
echo ===================================================
echo.
echo กำลังเริ่มต้นระบบ...
echo.

REM ตรวจสอบ IP address
for /f "tokens=4" %%a in ('route print ^| findstr 0.0.0.0.*0.0.0.0') do (
    set LOCAL_IP=%%a
)

echo [1] เปิดบนเครื่องคอมพิวเตอร์เครื่องนี้:
echo     http://localhost:8000
echo.
echo [2] กรรมการเปิดผ่านมือถือ/แท็บเล็ตในวง Wi-Fi เดียวกัน:
echo     http://%LOCAL_IP%:8000
echo.
echo ===================================================
echo * ปิดหน้าต่างนี้เมื่อต้องการหยุดการทำงานของระบบ *
echo ===================================================
echo.

python -m uvicorn main:app --host 0.0.0.0 --port 8000
pause

